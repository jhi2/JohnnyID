</script>

  <div class="cf-turnstile" id="turnstile-widget" data-sitekey="0x4AAAAAACxBew8Lvrla-MB3"></div>
  <script>
    (function() {
      const widget = document.getElementById('turnstile-widget');
      const theme = document.documentElement.getAttribute('data-theme') || 'dark';
      widget.setAttribute('data-theme', theme);
      new MutationObserver(() => {
        const t = document.documentElement.getAttribute('data-theme');
        widget.setAttribute('data-theme', t);
        if (window.turnstile) turnstile.reset('#turnstile-widget');
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    })();
  </script>
  <button type="submit" id="password-submit">Next</button>
</form>

